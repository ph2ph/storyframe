{
  "name": "@ph2ph/storyframe",
  "version": "0.1.0",
  "description": "Design system in Figma from a Storybook catalog: export of stories and theme for the storyframe Figma plugin, and the Variants block for Storybook docs pages",
  "type": "module",
  "license": "MIT",
  "author": "Ivan Starynkevich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph2ph/storyframe.git"
  },
  "homepage": "https://github.com/ph2ph/storyframe#readme",
  "bugs": "https://github.com/ph2ph/storyframe/issues",
  "keywords": [
    "figma",
    "figma-plugin",
    "storybook",
    "design-system",
    "design-tokens",
    "variables"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": "dist/bin/storyframe.js",
  "exports": {
    "./config": {
      "types": "./dist/app/config.d.ts",
      "default": "./dist/app/config.js"
    },
    "./mui": {
      "types": "./dist/app/mui/index.d.ts",
      "default": "./dist/app/mui/index.js"
    },
    "./storybook": {
      "types": "./dist/app/storybook/index.d.ts",
      "default": "./dist/app/storybook/index.js"
    },
    "./format": {
      "types": "./dist/app/export/capture/types.d.ts",
      "default": "./dist/app/export/capture/types.js"
    },
    "./variants": {
      "types": "./dist/app/export/variants.d.ts",
      "default": "./dist/app/export/variants.js"
    },
    "./zip": {
      "types": "./dist/app/export/zip.d.ts",
      "default": "./dist/app/export/zip.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.1"
  },
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node -e \"fs.chmodSync('dist/bin/storyframe.js', 0o755)\"",
    "prepack": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "esbuild": "0.28.1",
    "valibot": "^1.4.0"
  },
  "peerDependencies": {
    "@storybook/addon-docs": ">=10.6",
    "@storybook/react-vite": ">=10.6",
    "react": ">=18",
    "storybook": ">=10.6",
    "storybook-addon-pseudo-states": ">=10.6",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "@storybook/addon-docs": {
      "optional": true
    },
    "@storybook/react-vite": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "storybook": {
      "optional": true
    },
    "storybook-addon-pseudo-states": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14",
    "@emotion/styled": "^11.14",
    "@mui/material": "9.1.2",
    "@storybook/addon-docs": "~10.6.4",
    "@storybook/react-vite": "~10.6.4",
    "@types/jsdom": "^30",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "jsdom": "^30",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "storybook": "~10.6.4",
    "storybook-addon-pseudo-states": "~10.6.4",
    "typescript": "~6.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
